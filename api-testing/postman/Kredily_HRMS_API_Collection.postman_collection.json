            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/mapi/v1/leave/balances/me",
              "host": ["{{base_url}}"],
              "path": ["mapi", "v1", "leave", "balances", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 401\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST - Submit Leave Application (Positive)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leave_type\": \"CL\",\n  \"start_date\": \"2026-09-28\",\n  \"end_date\": \"2026-09-28\",\n  \"reason\": \"API Automated QA Validation - Family Function\",\n  \"half_day\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/ws/v1/employee-leave-request/request-leave/",
              "host": ["{{base_url}}"],
              "path": ["ws", "v1", "employee-leave-request", "request-leave", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200, 201 or 401\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST - Apply Leave with Inverted Dates (Negative - BUG-003)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leave_type\": \"CL\",\n  \"start_date\": \"2026-09-28\",\n  \"end_date\": \"2026-09-20\",\n  \"reason\": \"Invalid Date Range Test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/ws/v1/employee-leave-request/request-leave/",
              "host": ["{{base_url}}"],
              "path": ["ws", "v1", "employee-leave-request", "request-leave", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Server should reject inverted date ranges with 400 or 422\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422, 401]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
