              "raw": "{{base_url}}/ws/v2/company/get-announcements-and-wishes",
              "host": ["{{base_url}}"],
              "path": ["ws", "v2", "company", "get-announcements-and-wishes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 401\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Leave Management APIs",
      "item": [
        {
          "name": "GET - Current Employee Leave Balances",
          "request": {
